# NDX Terminal configuration. Every key is optional: providers without a key are shown as
# "disabled (no key)" and their values show N.A. (no fake fallbacks).
# Preferred: store keys in the macOS Keychain instead of this file (Keychain wins over .env):
#   cd server && uv run python -m ndx_server.secrets_store set FINNHUB_API_KEY
# In the packaged app this file is read from ~/Library/Application Support/NDX Terminal/.env

# Finnhub (quotes, company news, earnings calendar). Free: https://finnhub.io/register
FINNHUB_API_KEY=

# Tiingo Starter (US live secondary, RT·REF; memory only). https://www.tiingo.com
TIINGO_API_KEY=

# Massive (ex-Polygon) Stocks Basic (US bars history, 2 years). https://massive.com
MASSIVE_API_KEY=

# EODHD Free (EU/Nordic EOD; 20 calls/day, ≤ 18 symbols/day).
# https://eodhd.com/register
EODHD_API_KEY=

# Alpha Vantage (rare backfills only, never in live paths; 25 requests/day on the free tier).
# Free: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# FRED (macro series, release dates; memory only, never cached on disk). Free: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# CoinGecko demo key (optional, raises rate limits). https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with contact info, e.g. "Jane Doe jane@example.com".
# Filings (CF/INS) and SEC fundamentals (FA) are disabled until this is set.
EDGAR_USER_AGENT=

# Optional extra RSS/Atom feeds for TOP / CN, comma-separated. None by default: add feeds on the
# PDF NEWS page instead, after checking each publisher's terms (docs/PROVIDERS.md §3.14).
# RSS_FEEDS=

# Folder with your Python backtest scripts for BT (see docs/FUNCTIONS.md#bt).
BT_RESEARCH_DIR=

# The port and the per-launch token are chosen by the launcher (make dev / the app); there is
# no fixed port and no token setting here.
